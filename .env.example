# Supabase Configuration
# Obtenez ces valeurs depuis votre projet Supabase: https://app.supabase.com
# Allez dans Settings > API pour trouver l'URL et la clé anonyme

# URL de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Clé anonyme (publique) de votre projet Supabase
# Cette clé est sûre à exposer côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
